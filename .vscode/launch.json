{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Terminal Chat App",
      "program": "${workspaceFolder}/${input:entryFile}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": [],
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Server",
      "program": "${workspaceFolder}/index.mjs",
      "envFile": "${workspaceFolder}/.env",
      "postDebugTask": "open-browser"
    }
  ],
  "inputs": [
    {
      "type": "pickString",
      "id": "entryFile",
      "description": "Select the entry file to debug",
      "options": [
        "index.js",
        "run-dev.js",
        "app/infrastructure/express.mjs"
      ]
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "open-browser",
        "type": "shell",
        "command": "open http://localhost:3000"
      }
    ]
  }
}

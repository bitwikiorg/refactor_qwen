{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/core/config/chats",
  "title": "Chat Configuration Validation",
  "type": "object",
  "properties": {
    "rateLimit": {
      "$ref": "#/$defs/rateLimiterConfig"
    },
    "sanitizer": {
      "$ref": "#/$defs/sanitizerConfig"
    }
  },
  "required": ["rateLimit", "sanitizer"],
  "$defs": {
    "rateLimiterConfig": {
      "type": "object",
      "properties": {
        "windowMs": { "type": "number", "minimum": 60000 },
        "maxRequestsPerWindow": { "type": "integer", "minimum": 1 }
      },
      "required": ["windowMs", "maxRequestsPerWindow"]
    },
    "sanitizerConfig": {
      "type": "object",
      "properties": {
        "allowedTags": { "type": "array", "items": { "type": "string" } },
        "allowedAttributes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "minCharLength": { "type": "number", "minimum": 5 },
        "maxContentLength": { "type": "number", "maximum": 256 }
      },
      "required": ["allowedTags"]
    }
  }
}
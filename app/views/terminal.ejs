<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'CORE AI Terminal' %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/terminal.css">
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/terminal.js"></script>
</head>
<body class="terminal-page">
  <div class="container terminal-container">
    <%- include('partials/navbar') %>
    
    <header class="page-header">
      <h1>CORE AI Terminal</h1>
      <div class="status-indicator" id="socket-status" title="Disconnected"></div>
    </header>

    <main class="terminal-interface">
      <div id="terminal-output" class="terminal-output"></div>
      
      <form id="terminal-form" class="terminal-form">
        <div class="terminal-input-wrapper">
          <span class="terminal-prompt">&gt;</span>
          <input type="text" id="terminal-input" class="terminal-input" autocomplete="off" autofocus placeholder="Type a command...">
        </div>
      </form>
    </main>

    <footer class="terminal-footer">
      <div class="terminal-status">
        <span id="memory-status">Memory: Operational</span>
        <span id="research-status">Research: Online</span>
        <span id="ai-status">AI: Connected</span>
      </div>
    </footer>
  </div>

  <script src="/js/system-status.js"></script>
</body>
</html>
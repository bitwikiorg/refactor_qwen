{
  "name": "coreai-research-system",
  "version": "2.0.0",
  "description": "AI-driven research assistant with multi-layer memory and automation",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node run-dev.js",
    "dev:watch": "nodemon --ext ts,js,json --exec \"npm run dev\"",
    "build": "tsc",
    "prestart": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:client": "eslint app/public/js/*.js --fix",
    "lint:server": "eslint index.js app/features app/infrastructure app/services --fix",
    "test": "mocha --recursive",
    "test:coverage": "nyc npm test",
    "security-check": "npm audit"
  },
  "keywords": [
    "ai",
    "research",
    "memory",
    "chatbot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "@types/node": "^18.0.6",
    "argon2": "^0.31.2",
    "axios": "^1.8.2",
    "bcrypt": "^5.1.1",
    "celebrate": "^15.0.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "node-cron": "^3.0.3",
    "sanitize-html": "^2.15.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "vitest": "^3.0.8",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/jest": "^29.5.14",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.0.3",
    "nyc": "^15.1.0",
    "sinon": "^15.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
